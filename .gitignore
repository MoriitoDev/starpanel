# Dependencies
node_modules/

# Build output: the Dashboard build is embedded by the Go package, and the
# binary itself is produced by `pnpm build` at the repo root.
apps/api/webdist/*
!apps/api/webdist/.gitkeep
apps/api/star-panel
apps/api/star-panel.exe
# Go leaves this behind when the old binary is still running during a rebuild
apps/api/star-panel.exe~
apps/web/dist/

# Local runs
*.log

# Local state: the Dashboard document is created at runtime, never shipped.
# A fresh clone starts from the seeded default Dashboard instead.
apps/api/data/
# Imported Themes are the owner's, not the repository's.
apps/api/themes/

# The disk Plugin: the compiled backend and the ZIP it ships as are built, not
# committed, and its journal is written at runtime. The Go cache lives here too
# so a build never has to touch the user's profile.
apps/api/plugins/disk-space/backend
apps/api/plugins/disk-space/dist/
apps/api/plugins/disk-space/state/
.gocache/
.gomodcache/

# Tool output
.openchamber/screenshots/
